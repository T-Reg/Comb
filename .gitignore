# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover / JetBrains IDE configuration. Ignored outright: it is per-machine
# state that differs between the two checkouts this project is developed from,
# and it is noise in a commit history meant to be read.
.idea/

tmp/*
